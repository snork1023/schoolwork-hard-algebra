# --- GLOBAL SITE HEADERS ---
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# --- SYSTEM DIRECTORY PROTECTION ---
/.git*
  Content-Security-Policy: default-src 'none';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/*/.git*
  Content-Security-Policy: default-src 'none';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/node_modules*
  Content-Security-Policy: default-src 'none';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/*/.vscode*
  Content-Security-Policy: default-src 'none';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/*/.idea*
  Content-Security-Policy: default-src 'none';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

