# Copy this file to .env and fill in real values.
# Vite exposes VITE_* vars to the browser. Never put server-only secrets here.

# --- Supabase (existing site features: /auth, /chat AI, /account) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Firebase (Chime — /community-chat) ---
# From Firebase Console → Project settings → Your apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- hCaptcha (Chime signup) ---
# Get a sitekey at https://www.hcaptcha.com/. Falls back to a test key if blank.
VITE_HCAPTCHA_SITE_KEY=

# --- AI Chat (Firebase Cloud Function) ---
# Override only if you deployed the function under a different name/region.
# When blank, the client derives:
#   https://us-central1-${VITE_FIREBASE_PROJECT_ID}.cloudfunctions.net/aiChat
VITE_AI_CHAT_URL=
